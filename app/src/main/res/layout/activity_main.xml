<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="PIRA ✦" android:textColor="@color/pira_ink" android:textSize="36sp" android:textStyle="bold" />
  <TextView android:id="@+id/connectionState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="●  OFFLINE" android:textColor="@color/pira_muted" android:textSize="13sp" android:textStyle="bold" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center" android:text="Hi! What should we do?" android:textColor="@color/pira_lilac" android:textSize="24sp" android:textStyle="bold" />

  <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:columnCount="2" android:rowCount="2" android:useDefaultMargins="true">
   <Button android:id="@+id/myBrain" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/tile_peach" android:contentDescription="Connect my brain" android:text="01  /  BRAIN" android:textColor="@color/pira_ink" android:textSize="16sp" android:textStyle="bold" />
   <Button android:id="@+id/myEyes" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/tile_lavender" android:contentDescription="Use my eyes" android:text="02  /  EYES" android:textColor="@color/pira_ink" android:textSize="16sp" android:textStyle="bold" />
   <Button android:id="@+id/myVoice" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/tile_mint" android:contentDescription="Use my voice" android:text="03  /  VOICE" android:textColor="@color/pira_ink" android:textSize="16sp" android:textStyle="bold" />
   <Button android:id="@+id/mySafety" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/tile_blue" android:contentDescription="Open my safety" android:text="04  /  SAFETY" android:textColor="@color/pira_ink" android:textSize="16sp" android:textStyle="bold" />
  </GridLayout>
  <Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="22dp" android:backgroundTint="#8E315D" android:contentDescription="Emergency stop" android:text="EMERGENCY STOP" android:textColor="@color/pira_ink" android:textStyle="bold" />
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="Ready when you are" android:textColor="@color/pira_muted" android:textSize="14sp" />

  <LinearLayout android:id="@+id/brainPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/pira_card" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/connectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Connections" android:textColor="@color/pira_ink" android:textSize="22sp" android:textStyle="bold" />
    <Button android:id="@+id/closeConnections" android:layout_width="48dp" android:layout_height="48dp" android:backgroundTint="@color/pira_indigo" android:contentDescription="Close connections" android:text="×" android:textColor="@color/pira_ink" android:textSize="22sp" />
   </LinearLayout>
   <TextView android:id="@+id/brainGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="What are we curious about?" android:textColor="@color/pira_ink" android:textSize="22sp" android:textStyle="bold" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
    <Button android:id="@+id/askMode" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:backgroundTint="@color/pira_blue" android:text="ASK PIRA" android:textColor="@color/pira_night" android:textStyle="bold" />
   </LinearLayout>
   <LinearLayout android:id="@+id/brainConfig" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Connect once. PIRA keeps the key protected." android:textColor="@color/pira_muted" android:textSize="13sp" />
   <TextView android:id="@+id/nebiusConnected" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="●  NEBIUS CONNECTED" android:textColor="@color/pira_peach" android:textSize="16sp" android:textStyle="bold" android:visibility="gone" />
   <TextView android:id="@+id/currentSetup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No active setup" android:textColor="@color/pira_muted" android:textSize="13sp" />
   <EditText android:id="@+id/nebiusKey" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/pira_input" android:hint="Paste your Nebius key" android:inputType="textPassword" android:textColor="@color/pira_ink" android:textColorHint="@color/pira_muted" />
   <CheckBox android:id="@+id/showKey" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Show while typing" android:textColor="@color/pira_muted" />
   <Button android:id="@+id/saveKey" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/pira_primary" android:text="CONNECT MY BRAIN" android:textColor="@color/pira_night" android:textStyle="bold" />
   <EditText android:id="@+id/model" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/pira_input" android:hint="Choose a discovered model" android:textColor="@color/pira_ink" android:textColorHint="@color/pira_muted" />
   <Button android:id="@+id/discoverModels" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:backgroundTint="@color/pira_indigo" android:text="FIND MY MODELS" android:textColor="@color/pira_ink" />
   <LinearLayout android:id="@+id/modelOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Agent capabilities" android:textColor="@color/pira_ink" android:textSize="16sp" android:textStyle="bold" />
   <EditText android:id="@+id/tavilyKey" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/pira_input" android:hint="Tavily key (saved securely)" android:inputType="textPassword" android:textColor="@color/pira_ink" android:textColorHint="@color/pira_muted" />
   <Button android:id="@+id/saveTavily" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:backgroundTint="@color/pira_indigo" android:text="CONNECT SEARCH" android:textColor="@color/pira_ink" />
   </LinearLayout>
   <LinearLayout android:id="@+id/askContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <EditText android:id="@+id/askPrompt" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="18dp" android:background="@drawable/pira_input" android:hint="Write a message…" android:imeOptions="actionSend" android:inputType="textCapSentences|textMultiLine" android:padding="18dp" android:textColor="@color/pira_ink" android:textColorHint="@color/pira_muted" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
    <Button android:id="@+id/testNebius" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:background="@drawable/pira_primary" android:text="SEND  ➤" android:textColor="@color/pira_night" android:textStyle="bold" />
    <Button android:id="@+id/voiceNote" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="8dp" android:backgroundTint="@color/pira_indigo" android:contentDescription="Send a voice note" android:text="🎙" android:textSize="22sp" />
   </LinearLayout>
   <Button android:id="@+id/investigate" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:backgroundTint="@color/pira_indigo" android:text="INVESTIGATE THIS  ✦" android:textColor="@color/pira_ink" android:textStyle="bold" />
   <TextView android:id="@+id/chatTranscript" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/pira_card" android:padding="16dp" android:textColor="@color/pira_ink" android:textSize="16sp" android:lineSpacingExtra="4dp" android:visibility="gone" />
   </LinearLayout>
   <LinearLayout android:id="@+id/searchContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
   <EditText android:id="@+id/searchQuery" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/pira_input" android:hint="What should I look up?" android:textColor="@color/pira_ink" android:textColorHint="@color/pira_muted" />
   <Button android:id="@+id/searchWeb" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:background="@drawable/pira_primary" android:text="SEARCH THE WEB" android:textColor="@color/pira_night" android:textStyle="bold" />
   </LinearLayout>
   <Button android:id="@+id/useSetup" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="14dp" android:background="@drawable/pira_primary" android:text="USE THIS SETUP" android:textColor="@color/pira_night" android:textStyle="bold" android:visibility="gone" />
   <Button android:id="@+id/clearSetup" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:backgroundTint="@color/pira_card" android:text="CLEAR CONFIGURATION" android:textColor="@color/pira_muted" android:visibility="gone" />
  </LinearLayout>
  <LinearLayout android:id="@+id/eyesPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/pira_card" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show me something" android:textColor="@color/pira_ink" android:textSize="24sp" android:textStyle="bold" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Ask a question, then let PIRA look for the answer." android:textColor="@color/pira_muted" android:textSize="14sp" />
   <EditText android:id="@+id/eyesQuestion" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="18dp" android:background="@drawable/pira_input" android:hint="Ask what you want to know about the scene" android:inputType="textCapSentences|textMultiLine" android:padding="18dp" android:textColor="@color/pira_ink" android:textColorHint="@color/pira_muted" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
    <Button android:id="@+id/look" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:backgroundTint="@color/pira_blue" android:text="TAKE A LOOK" android:textColor="@color/pira_ink" android:textStyle="bold" />
    <Button android:id="@+id/eyesVoice" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="8dp" android:backgroundTint="@color/pira_indigo" android:contentDescription="Ask with your voice" android:text="🎙" android:textSize="22sp" />
   </LinearLayout>
   <Button android:id="@+id/analyzeEyes" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:background="@drawable/pira_primary" android:text="ASK ABOUT THIS PHOTO  ✦" android:textColor="@color/pira_night" android:textStyle="bold" />
   <TextView android:id="@+id/visionTranscript" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/pira_card" android:padding="16dp" android:textColor="@color/pira_ink" android:textSize="16sp" android:lineSpacingExtra="4dp" android:visibility="gone" />
  </LinearLayout>
  <LinearLayout android:id="@+id/safetyPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/pira_card" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="You are in control" android:textColor="@color/pira_ink" android:textSize="20sp" android:textStyle="bold" />
   <Button android:id="@+id/denyTest" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:backgroundTint="@color/pira_indigo" android:text="TRY A DENIAL TEST" android:textColor="@color/pira_ink" />
   <TextView android:id="@+id/audit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="No activity yet" android:textColor="@color/pira_muted" android:textSize="13sp" />
  </LinearLayout>
  <TextView android:id="@+id/auditFallback" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <LinearLayout android:id="@+id/controlDock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
   <Button android:id="@+id/connections" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:backgroundTint="@color/pira_indigo" android:text="CONNECT" android:textColor="@color/pira_ink" android:textSize="11sp" />
   <Button android:id="@+id/devices" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="6dp" android:layout_weight="1" android:backgroundTint="@color/pira_indigo" android:text="DEVICES" android:textColor="@color/pira_ink" android:textSize="11sp" />
  </LinearLayout>
  <ImageView android:id="@+id/pirophoneMascot" android:layout_width="112dp" android:layout_height="90dp" android:layout_gravity="end" android:layout_marginTop="14dp" android:contentDescription="Pirophone waving" android:scaleType="fitCenter" android:src="@drawable/pirophone" android:alpha="0.96" />
 </LinearLayout>
</ScrollView>
