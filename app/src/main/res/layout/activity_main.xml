<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="PIRA ✦" android:textColor="@color/pira_ink" android:textSize="36sp" android:textStyle="bold" />
  <TextView android:id="@+id/connectionState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="●  OFFLINE" android:textColor="@color/pira_muted" android:textSize="13sp" android:textStyle="bold" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center" android:text="Hi! What should we do?" android:textColor="@color/pira_lilac" android:textSize="24sp" android:textStyle="bold" />

  <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:columnCount="2" android:rowCount="2" android:useDefaultMargins="true">
   <Button android:id="@+id/myBrain" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/tile_peach" android:contentDescription="Connect my brain" android:text="01  /  BRAIN" android:textColor="@color/pira_ink" android:textSize="16sp" android:textStyle="bold" />
   <Button android:id="@+id/myEyes" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/tile_lavender" android:contentDescription="Use my eyes" android:text="02  /  EYES" android:textColor="@color/pira_ink" android:textSize="16sp" android:textStyle="bold" />
   <Button android:id="@+id/myVoice" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/tile_mint" android:contentDescription="Use my voice" android:text="03  /  VOICE" android:textColor="@color/pira_ink" android:textSize="16sp" android:textStyle="bold" />
   <Button android:id="@+id/mySafety" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/tile_blue" android:contentDescription="Open my safety" android:text="04  /  SAFETY" android:textColor="@color/pira_ink" android:textSize="16sp" android:textStyle="bold" />
  </GridLayout>
  <Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="22dp" android:backgroundTint="#8E315D" android:contentDescription="Emergency stop" android:text="EMERGENCY STOP" android:textColor="@color/pira_ink" android:textStyle="bold" />
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="Ready when you are" android:textColor="@color/pira_muted" android:textSize="14sp" />

  <LinearLayout android:id="@+id/brainPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/pira_card" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Let's connect my brain" android:textColor="@color/pira_ink" android:textSize="22sp" android:textStyle="bold" />
   <EditText android:id="@+id/nebiusKey" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/pira_input" android:hint="Paste your Nebius key" android:inputType="textPassword" android:textColor="@color/pira_ink" android:textColorHint="@color/pira_muted" />
   <CheckBox android:id="@+id/showKey" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Show while typing" android:textColor="@color/pira_muted" />
   <Button android:id="@+id/saveKey" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/pira_primary" android:text="CONNECT MY BRAIN" android:textColor="@color/pira_night" android:textStyle="bold" />
   <EditText android:id="@+id/model" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/pira_input" android:hint="Choose a discovered model" android:textColor="@color/pira_ink" android:textColorHint="@color/pira_muted" />
   <Button android:id="@+id/discoverModels" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:backgroundTint="@color/pira_indigo" android:text="FIND MY MODELS" android:textColor="@color/pira_ink" />
   <EditText android:id="@+id/prompt" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/pira_input" android:hint="Ask me something" android:textColor="@color/pira_ink" android:textColorHint="@color/pira_muted" />
   <Button android:id="@+id/testNebius" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:background="@drawable/pira_primary" android:text="ASK MY BRAIN" android:textColor="@color/pira_night" android:textStyle="bold" />
   <EditText android:id="@+id/tavilyKey" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:background="@drawable/pira_input" android:hint="Optional Tavily search key" android:inputType="textPassword" android:textColor="@color/pira_ink" android:textColorHint="@color/pira_muted" />
   <Button android:id="@+id/saveTavily" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:backgroundTint="@color/pira_indigo" android:text="SAVE SEARCH KEY" android:textColor="@color/pira_ink" />
   <EditText android:id="@+id/searchQuery" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/pira_input" android:hint="Search related information" android:textColor="@color/pira_ink" android:textColorHint="@color/pira_muted" />
   <Button android:id="@+id/searchWeb" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:background="@drawable/pira_primary" android:text="SEARCH THE WEB" android:textColor="@color/pira_night" android:textStyle="bold" />
  </LinearLayout>
  <LinearLayout android:id="@+id/eyesPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/pira_card" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My eyes need your permission" android:textColor="@color/pira_ink" android:textSize="20sp" android:textStyle="bold" />
   <Button android:id="@+id/look" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:backgroundTint="@color/pira_blue" android:text="LOOK AT SOMETHING" android:textColor="@color/pira_ink" />
  </LinearLayout>
  <LinearLayout android:id="@+id/safetyPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/pira_card" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="You are in control" android:textColor="@color/pira_ink" android:textSize="20sp" android:textStyle="bold" />
   <Button android:id="@+id/denyTest" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:backgroundTint="@color/pira_indigo" android:text="TRY A DENIAL TEST" android:textColor="@color/pira_ink" />
   <TextView android:id="@+id/audit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="No activity yet" android:textColor="@color/pira_muted" android:textSize="13sp" />
  </LinearLayout>
  <TextView android:id="@+id/auditFallback" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <ImageView android:id="@+id/pirophoneMascot" android:layout_width="112dp" android:layout_height="90dp" android:layout_gravity="end" android:layout_marginTop="14dp" android:contentDescription="Pirophone waving" android:scaleType="fitCenter" android:src="@drawable/pirophone" android:alpha="0.96" />
 </LinearLayout>
</ScrollView>
